    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "df_biv = pd.DataFrame({\n",
        "    \"tinggi\": x,\n",
        "    \"berat\": y\n",
        "})\n",
        "\n",
        "df_biv.head()"
      ],
