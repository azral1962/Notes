      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "Dengan NumPy:"
      ],
      "id": "7202b90c"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "np.cov(x, y)"
      ],
      "id": "815b30f7",
      "execution_count": null,
      "outputs": []
    },
