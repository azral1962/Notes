      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "Dengan NumPy:"
      ],
      "id": "b41610ce"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "np.cov(x, y)"
      ],
      "id": "c8a4bc1e",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
