        "\n",
        "### Mean masing-masing variabel"
      ],
      "id": "96112be7"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "df_biv.mean()"
      ],
      "id": "f68eac6b",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Variansi dan kovariansi"
      ],
      "id": "75066d2a"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "df_biv.cov()"
      ],
      "id": "c4c1b8a5",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Korelasi"
      ],
      "id": "323a2604"
    },
    {
      "cell_type": "code",
