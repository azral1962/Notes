      ],
      "id": "e347f1de"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "np.cov(x, y)"
      ],
      "id": "699eda91",
      "execution_count": null,
      "outputs": []
    },
    {
